ENV=prod
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=webhook_tester
DB_HOST=db
DB_PORT=5432
DOMAIN=http://localhost:3000
# Must be 32 bytes
AUTH_SECRET=oqO+IHqktGEU/CRnCjSu/C5sUpEKn+YnTHcT31ujWOg=
# Internal address for Prometheus metrics; keep it off the public network
METRICS_ADDR=:9091

# SMTP server for password reset emails. Without SMTP_HOST, emails are
# written to the server log instead (fine for local development).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM="Webhook Tester <no-reply@example.com>"
