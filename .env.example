ENV=prod
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=webhook_tester
DB_HOST=db
DB_PORT=5432
DOMAIN=http://localhost:3000
# Must be 32 bytes
AUTH_SECRET=oqO+IHqktGEU/CRnCjSu/C5sUpEKn+YnTHcT31ujWOg=
# Internal address for Prometheus metrics; keep it off the public network
METRICS_ADDR=:9091

# SMTP server for password reset emails. Without SMTP_HOST, emails are
# written to the server log instead (fine for local development).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM="Webhook Tester <no-reply@example.com>"

# Forwarding captured requests to a webhook's forward URL.
# Allow private, loopback and link-local targets (e.g. localhost). Self-hosted
# only: keep it false on a public instance.
FORWARD_ALLOW_PRIVATE_NETWORKS=false
# Time limit for one forward, as a Go duration
FORWARD_TIMEOUT=10s
# Automatic forwards in flight at once
FORWARD_MAX_CONCURRENT=32
